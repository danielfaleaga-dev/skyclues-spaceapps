+
+def save(label, payload):
+    OUT.mkdir(parents=True, exist_ok=True)
+    (OUT / f"{label}.json").write_text(json.dumps(payload, indent=1, ensure_ascii=False, default=jsonable),
+                                       encoding="utf-8")
